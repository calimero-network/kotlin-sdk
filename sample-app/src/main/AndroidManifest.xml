<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Mero Sample"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MeroSample">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Calimero Cloud sign-in callback: the wallet redirects to
              mero-sample://enrol#credential=…&account=…&device=…&state=… (or #error=cancelled).
              Keep in sync with MainActivity.DEFAULT_CALLBACK_URL. An https App Link works too
              (pass it as the callbackUrl extra and add a verified filter for it).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mero-sample" android:host="enrol" />
            </intent-filter>
        </activity>
    </application>
</manifest>
